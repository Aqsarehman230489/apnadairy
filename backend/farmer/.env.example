# Copy to .env and fill with REAL values (Supabase dashboard -> Project Settings -> API).
# NEVER commit .env to git. Rotate any key that was ever pasted in chat.
# Farmer portal v2: this backend talks to ONE Supabase project only.

# --- apnadairy-web project: the SINGLE database (primary read+write) ---
# Tables: profiles, farmer_profiles, farmers, farmer_requests,
# area_managers, milk_collections, farmer_payouts (+ web storage buckets).
SUPABASE_WEB_URL=https://xyzcompany.supabase.co
SUPABASE_WEB_SERVICE_KEY=your-web-service-role-key-here

# SECRET — backend server ONLY. Never put service_role keys in the mobile
# app, the web app, or any chat message.

# Market milk price (Rs per litre) used by the AI price engine.
MARKET_MILK_PRICE_PER_L=220

# Demo auth fallback: when "true", requests without a valid Supabase JWT
# fall back to DEMO_FARMER_ID (local dev convenience ONLY). Defaults to
# "false" — the demo fallback is IMPOSSIBLE in production unless explicitly
# enabled. Never enable outside local dev.
AUTH_DEMO_ENABLED=false
DEMO_FARMER_ID=your-demo-farmer-uuid-here
